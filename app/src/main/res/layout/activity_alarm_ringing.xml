<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#0A0714"
    android:padding="32dp">

    <TextView
        android:id="@+id/tvAlarmRingingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Morning Wake-Up ☀️"
        android:textColor="@color/md_theme_dark_secondary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAlarmRingingClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="07:00 AM"
        android:textColor="@color/md_theme_dark_onBackground"
        android:textSize="56sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="The alarm will keep ringing until you prove you are awake!"
        android:textColor="@color/md_theme_dark_onSurfaceVariant"
        android:textSize="14sp"
        android:gravity="center" />

    <!-- Challenge Preview Card with Graphical Icon -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardAlarmChallenge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="#171A2E"
        app:cardCornerRadius="20dp"
        app:cardElevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvAlarmChallengeIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧠"
                android:textSize="38sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAlarmChallengeName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cognitive Wake Challenge"
                    android:textColor="@color/md_theme_dark_onSurface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAlarmChallengeDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Solve to prove consciousness &amp; turn off alarm"
                    android:textColor="@color/md_theme_dark_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <View
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnSnoozeAlarm"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="16dp"
        android:text="Snooze (3 left)"
        android:textColor="@color/md_theme_dark_secondary" />

    <Button
        android:id="@+id/btnSolveChallenge"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="🧠 Solve Challenge to Stop Alarm"
        android:textSize="17sp"
        android:textStyle="bold"
        android:backgroundTint="@color/md_theme_dark_primary"
        android:textColor="@color/md_theme_dark_onPrimary" />

    <!-- Emergency stop after long timeout -->
    <Button
        android:id="@+id/btnEmergencyStopAlarm"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Emergency Stop (Hold 5s)"
        android:textColor="#8C6666"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
