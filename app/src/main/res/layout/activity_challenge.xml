<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_theme_dark_background"
    android:padding="16dp">

    <!-- Practice Mode Banner (visible in practice mode) -->
    <TextView
        android:id="@+id/tvPracticeBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2E240D"
        android:padding="8dp"
        android:text="PRACTICE MODE — No alarm active"
        android:textColor="@color/md_theme_dark_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Challenge Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChallengeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cognitive Challenge"
                android:textColor="@color/md_theme_dark_onBackground"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChallengeInstructions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/md_theme_dark_onSurfaceVariant"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvChallengeTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@color/md_theme_dark_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="#232940" />

    <!-- Dynamic Challenge Interactive Container -->
    <FrameLayout
        android:id="@+id/challengeContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
